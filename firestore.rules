rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // 1) Carreras: lectura pública, sólo admin escribe.
    match /carreras/{carreraId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2) Usuarios y subperfiles.
    match /usuarios/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      match /perfiles/{perfilId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // 3) Usuarios temporales.
    match /tempusuarios/{tempId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 4) Inscripciones.
    match /inscripciones/{inscId} {
      allow create: if (
        isSignedIn()
        && request.resource.data.perfilOwner == request.auth.uid
        && request.resource.data.paymentStatus in ["pending", "paid"]
      ) || (
        request.resource.data.perfilOwner == "manual"
        && request.resource.data.paymentStatus == "manual"
      );

      allow read: if isSignedIn();
      allow update: if isSignedIn()
        && resource.data.perfilOwner == request.auth.uid;
    }

    // 5) Testimonios.
    match /testimonios/{testimonioId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 6) Configuración de búsqueda activa.
    match /busquedaCompetidor/active {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Proyección pública usada por el buscador de recepción.
    match /busquedaCompetidor/active/publicCompetidores/{competidorId} {
      allow read: if true;

      // Recepción sólo puede pasar pendiente -> en_proceso.
      // La estación sólo puede pasar en_proceso -> entregado.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["estadoEntrega", "mesaId", "mesaNombre"])
        && (
          (
            resource.data.estadoEntrega == "pendiente"
            && request.resource.data.estadoEntrega == "en_proceso"
            && request.resource.data.mesaId is string
            && request.resource.data.mesaNombre is string
          )
          ||
          (
            resource.data.estadoEntrega == "en_proceso"
            && request.resource.data.estadoEntrega == "entregado"
            && request.resource.data.mesaId == resource.data.mesaId
            && request.resource.data.mesaNombre == resource.data.mesaNombre
          )
        );

      allow create, delete: if isAdmin();
    }

    // Registros mínimos que consumen las estaciones.
    match /busquedaCompetidor/active/entregas/{entregaId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          "competitorId", "estado", "mesaId", "mesaNombre", "bib",
          "participant", "routeName", "categoryName", "talla",
          "details", "encontradoAt", "entregadoAt"
        ])
        && request.resource.data.competitorId == entregaId
        && request.resource.data.estado == "en_proceso"
        && request.resource.data.mesaId is string
        && request.resource.data.mesaNombre is string
        && request.resource.data.bib is int
        && request.resource.data.bib > 0
        && request.resource.data.participant is string
        && request.resource.data.entregadoAt == null;

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["estado", "entregadoAt"])
        && resource.data.estado == "en_proceso"
        && request.resource.data.estado == "entregado"
        && request.resource.data.entregadoAt is timestamp;

      allow delete: if isAdmin();
    }

    // Configuración de entrega: lectura para estaciones autenticadas
    // (la sesión anónima se crea automáticamente al abrir el enlace).
    // El PIN es un control operativo, no un secreto de seguridad.
    match /configuracionEntrega/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 7) Regla global de administrador para el resto del sistema.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
