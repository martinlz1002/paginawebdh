rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // — helper para admin —
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
            .data.admin == true;
    }

    // 1) Carreras: lectura pública, sólo admin escribe
    match /carreras/{carreraId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // 2) Usuarios y subperfiles (cada uno sobre su propio doc)
    match /usuarios/{userId} {
      allow read, write:
        if request.auth != null && request.auth.uid == userId;
      match /perfiles/{perfilId} {
        allow read, write:
          if request.auth != null && request.auth.uid == userId;
      }
    }

    // 3) TempUsuarios (login temporal)
    match /tempusuarios/{tempId} {
      allow read:                   if true;      // cualquiera lee
      allow create, update, delete: if isAdmin(); // sólo admin escribe
    }

    // 4) Inscripciones: Stripe (auth) o Manual (abierto)
    match /inscripciones/{inscId} {
      // CREAR:
      // — Stripe: auth != null, perfilOwner = uid, status pending|paid
      // — Manual: venga quien venga con perfilOwner="manual"
      allow create: if (
           request.auth != null
        && request.resource.data.perfilOwner == request.auth.uid
        && (request.resource.data.paymentStatus == "pending"
         || request.resource.data.paymentStatus == "paid")
      ) || (
           request.resource.data.perfilOwner == "manual"
        && request.resource.data.paymentStatus == "manual"
      );

      // LEER: para asignar números y para mis-inscripciones
      allow read: if request.auth != null;

      // (Opcional) permitir que cada usuario actualice sólo SU inscripción
      allow update: if request.auth != null
        && resource.data.perfilOwner == request.auth.uid;
    }

    // 5) Override global: admin puede TODO
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /testimonios/{testimonioId} {
      allow read, write: if request.auth != null;
    }

    // Configuración pública del buscador: no contiene PIN ni hashes de acceso.
    match /busquedaCompetidor/active {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Proyección pública con únicamente los campos seleccionados para el buscador.
    match /busquedaCompetidor/active/publicCompetidores/{competidorId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Registros de entrega: contienen únicamente los datos mínimos que necesita cada mesa.
    // Las escrituras se realizan exclusivamente mediante Cloud Functions con PIN validado.
    match /busquedaCompetidor/active/entregas/{entregaId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }

}
