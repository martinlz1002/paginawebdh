rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // helper que detecta admins
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    // Carreras: lectura pública, sólo admin escribe
    match /carreras/{carreraId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Usuarios y subperfiles: cada quien solo sus propios docs
    match /usuarios/{userId} {
      allow get, list, create, update, delete:
        if request.auth != null && request.auth.uid == userId;
      match /perfiles/{perfilId} {
        allow get, list, create, update, delete:
          if request.auth != null && request.auth.uid == userId;
      }
    }

    // TempUsuarios: lectura abierta, solo admin escribe
    match /tempusuarios/{tempId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Inscripciones:
    match /inscripciones/{inscId} {
      // Stripe: cualquier usuario autenticado
      // Manual: cualquiera, siempre que ponga perfilOwner="manual" y paymentStatus="manual"
      allow create: if request.auth != null
                  || ( request.resource.data.perfilOwner == "manual"
                     && request.resource.data.paymentStatus == "manual" );
      // Leer: admin o dueño de la inscripción
      allow get, list: if isAdmin()
                    || ( request.auth != null
                       && resource.data.perfilOwner == request.auth.uid );
      // Actualizar/Borrar: solo admin
      allow update, delete: if isAdmin();
    }

    // Por defecto, todo lo demás solo admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
