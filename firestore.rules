rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    // 1) Carreras: lectura pública; escritura sólo para administradores.
    match /carreras/{carreraId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2) Usuarios y perfiles.
    match /usuarios/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /perfiles/{perfilId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // 3) Usuarios temporales.
    match /tempusuarios/{tempId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 4) Inscripciones. Se conserva el flujo actual.
    match /inscripciones/{inscId} {
      allow create: if (
        isSignedIn()
        && request.resource.data.perfilOwner == request.auth.uid
        && request.resource.data.paymentStatus in ["pending", "paid"]
      ) || (
        request.resource.data.perfilOwner == "manual"
        && request.resource.data.paymentStatus == "manual"
      );

      allow read: if isSignedIn();
      allow update: if isSignedIn()
        && resource.data.perfilOwner == request.auth.uid;
    }

    // 5) Testimonios: se conserva el acceso autenticado existente.
    match /testimonios/{testimonioId} {
      allow read, write: if isSignedIn();
    }

    // 6) Cronometraje por vueltas. Se conservan los permisos actuales.
    match /eventos_vueltas/{eventoId} {
      allow read, write: if true;

      match /equipos/{equipoId} {
        allow read, write: if true;
      }

      match /laps/{lapId} {
        allow read, write: if true;
      }

      match /fotos_evento/{fotoId} {
        allow read, write: if true;
      }

      match /comerciales/{comercialId} {
        allow read, write: if true;
      }
    }

    // 7) Documento de búsqueda activa y otros documentos de esta colección.
    match /busquedaCompetidor/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Colección privada original: sólo administradores pueden modificarla.
    match /busquedaCompetidor/{docId}/competidores/{competidorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Proyección pública utilizada por el buscador y por las estaciones.
    match /busquedaCompetidor/active/publicCompetidores/{competidorId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      // Recepción: pendiente -> en_proceso.
      // Estación: en_proceso -> entregado.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["estadoEntrega", "mesaId", "mesaNombre"])
        && (
          (
            resource.data.estadoEntrega == "pendiente"
            && request.resource.data.estadoEntrega == "en_proceso"
            && request.resource.data.mesaId is string
            && request.resource.data.mesaNombre is string
          )
          ||
          (
            resource.data.estadoEntrega == "en_proceso"
            && request.resource.data.estadoEntrega == "entregado"
            && request.resource.data.mesaId == resource.data.mesaId
            && request.resource.data.mesaNombre == resource.data.mesaNombre
          )
        );
    }

    // Movimientos mínimos de entrega consumidos por recepción, mesas y panel admin.
    match /busquedaCompetidor/active/entregas/{entregaId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          "competitorId", "estado", "mesaId", "mesaNombre", "bib",
          "participant", "routeName", "categoryName", "talla",
          "details", "encontradoAt", "entregadoAt"
        ])
        && request.resource.data.competitorId == entregaId
        && request.resource.data.estado == "en_proceso"
        && request.resource.data.mesaId is string
        && request.resource.data.mesaNombre is string
        && request.resource.data.bib is int
        && request.resource.data.bib > 0
        && request.resource.data.participant is string
        && request.resource.data.encontradoAt is timestamp
        && request.resource.data.entregadoAt == null;

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["estado", "entregadoAt"])
        && resource.data.estado == "en_proceso"
        && request.resource.data.estado == "entregado"
        && request.resource.data.entregadoAt is timestamp;

      allow delete: if isAdmin();
    }

    // Configuración de entrega: lectura sólo para estaciones autenticadas.
    // Incluye autenticación anónima. El PIN es un control operativo de interfaz,
    // no una autorización de seguridad validada por el servidor.
    match /configuracionEntrega/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 8) Regla global: los administradores conservan acceso total al resto del sistema.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
